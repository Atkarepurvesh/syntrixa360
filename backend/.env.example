# Copy to .env locally. Never commit .env or real API keys.
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BREVO_API_KEY=replace_with_your_brevo_api_key
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_SENDER_NAME=Syntrixa360 Website
BREVO_SENDER_EMAIL=verified-sender@your-domain.com
DEMO_NOTIFICATION_TO=support@syntrixa360.com
